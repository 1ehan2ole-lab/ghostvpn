<Window x:Class="GhostVPN.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GhostVPN" Height="720" Width="1040"
        MinHeight="560" MinWidth="880"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#06070F" Offset="0" />
            <GradientStop Color="#0C0A1E" Offset="0.5" />
            <GradientStop Color="#071019" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="13" Background="{StaticResource BrandGradient}">
                <TextBlock Text="👻" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="GhostVPN" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="StatusText" Text="Не подключено" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <Border Grid.Column="2" CornerRadius="999" Padding="14,7" Background="#141A2E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource ErrBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusLabel" Text="Отключено" Foreground="{StaticResource TextBrush}" FontSize="12.5" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Основная часть -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <!-- Левая колонка -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Подписка" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Вставьте ссылку подписки из личного кабинета или ключ vless://"
                                   FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SubscriptionBox" Style="{StaticResource InputStyle}" Padding="12,9"
                                     TextChanged="SubscriptionBox_OnTextChanged" />
                            <Button Grid.Column="1" Style="{StaticResource ButtonStyle}" Margin="10,0,0,0"
                                    Click="LoadSubscription_Click" Content="Загрузить" />
                        </Grid>
                        <TextBlock x:Name="SubscriptionInfo" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Серверы" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                        <ListBox x:Name="ServersList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="10" Background="#0E1224" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Endpoint}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" FontFamily="Consolas" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Security}" Foreground="{StaticResource AccentBrush}"
                                                       FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ConnectButton" Style="{StaticResource ButtonStyle}" Height="50" FontSize="15"
                            Click="Connect_Click" Content="Подключиться" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Margin="10,0,0,0" Padding="18,0"
                            Click="CopyKey_Click" Content="🔗" ToolTip="Скопировать ключ выбранного сервера" />
                </Grid>
            </Grid>

            <!-- Правая колонка -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="14,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Подключение" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Внешний IP" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                <TextBlock x:Name="ExternalIpText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" FontFamily="Consolas" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Трафик" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" />
                                <TextBlock x:Name="TrafficText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="14,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Параметры" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" />
                        <CheckBox x:Name="SystemProxyCheck" Style="{StaticResource CheckStyle}" Content="Системный прокси (SOCKS/HTTP)" IsChecked="True" />
                        <CheckBox x:Name="TunCheck" Style="{StaticResource CheckStyle}" Content="TUN-режим (весь трафик, нужны права администратора)" />
                        <CheckBox x:Name="AutoConnectCheck" Style="{StaticResource CheckStyle}" Content="Подключаться при запуске" />
                        <TextBlock x:Name="CoreHint" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Системный прокси не покрывает QUIC/HTTP3 - для YouTube, Discord и игр включите TUN-режим." />
                        <Button x:Name="DownloadCoreButton" Style="{StaticResource GhostButtonStyle}" Margin="0,10,0,0"
                                Click="DownloadCore_Click" Content="Скачать ядро sing-box" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="14,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Журнал" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                 Style="{StaticResource InputStyle}" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11.5" TextWrapping="NoWrap" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Подвал -->
        <TextBlock Grid.Row="2" Text="GhostVPN Client 1.0 · ядро sing-box" Margin="0,14,0,0"
                   Foreground="{StaticResource MutedBrush}" FontSize="11.5" />
    </Grid>
</Window>
