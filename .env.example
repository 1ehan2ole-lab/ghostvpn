# ---------------------------------------------------------------------------
# GhostVPN configuration
# Copy to .env and adjust. Every value below is optional - the app boots with
# sensible defaults and generates missing secrets on first run.
# ---------------------------------------------------------------------------

# --- Web panel -------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Public domain of the panel, used to build subscription links
# (e.g. https://vpn.example.com). Leave empty to auto-detect from the request.
PUBLIC_URL=
# Set to 1 when running behind nginx/caddy/cloudflare so rate limiting and
# IP detection see the real client address.
TRUST_PROXY=0

# --- Storage ---------------------------------------------------------------
DATA_DIR=./data

# --- Xray core -------------------------------------------------------------
# Path to the xray executable. If it does not exist, "xray" from PATH is used.
XRAY_BIN=./vendor/xray/xray.exe
# Public address of the VPN node, used inside the generated client configs
SERVER_HOST=
SERVER_PORT=443

# --- Reality (VLESS + REALITY) --------------------------------------------
# SNI + destination used to mimic a legit TLS site
REALITY_SNI=www.apple.com
REALITY_DEST=www.apple.com:443
# Optional pinned public key of the destination site (empty = auto)
REALITY_PUBKEY=
REALITY_SHORT_ID=
REALITY_FINGERPRINT=chrome
# Short ids pool for clients (generated automatically if empty)
REALITY_SHORT_IDS=

# --- Branding --------------------------------------------------------------
SITE_NAME=GhostVPN
SITE_TAGLINE=Приватный и быстрый VPN
SUPPORT_URL=https://t.me/ghostvpn_support
# Currency + prices shown on the landing page
CURRENCY=$
PRICE_1M=4.99
PRICE_3M=12.99
PRICE_6M=22.99
PRICE_12M=39.99
# Traffic quota in GB for a new account (0 = unlimited)
DEFAULT_TRAFFIC_GB=0
# Account lifetime in days (0 = lifetime)
TRIAL_DAYS=0
# Allow visitors to register on their own
REGISTRATION_OPEN=1
# Require an invite code during registration
INVITE_REQUIRED=0
INVITE_CODES=
# Max simultaneous devices (IP addresses) per user
DEVICE_LIMIT=3

# --- Bootstrap admin -------------------------------------------------------
# Created on the first run if no admin exists
ADMIN_EMAIL=admin@ghostvpn.local
ADMIN_PASSWORD=
# Session lifetime
SESSION_TTL_HOURS=168
